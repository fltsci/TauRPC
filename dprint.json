{
  "incremental": true,
  "lineWidth": 80,
  "typescript": {
    "quoteStyle": "preferSingle",
    "semiColons": "asi",
    "binaryExpression.operatorPosition": "maintain",
    "conditionalExpression.operatorPosition": "maintain",
    "conditionalType.operatorPosition": "maintain"
  },
  "exec": {
    "associations": "**/*.{rs}",
    "commands": [{
      "command": "rustfmt --edition 2024",
      "exts": ["rs"]
    }]
  },
  "includes": [
    "**/*.{ts,tsx,js,jsx,cjs,mjs,json,json5,md,yaml,rs}"
  ],
  "excludes": [
    "**/node_modules",
    "pnpm-lock.yaml",
    "dist",
    "bindings.ts",
    "proxy.ts",
    "**/target",
    "**/gen"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.0.wasm",
    "https://plugins.dprint.dev/json-0.21.3.wasm",
    "https://plugins.dprint.dev/markdown-0.21.1.wasm",
    "https://plugins.dprint.dev/exec-0.6.2.json@df98f54ffd3092b8a841aedd6d098a2651f16d0a796a40535774f1a8b4b9d463"
  ]
}
